# Dockerfile de desarrollo para TuRutaMed Frontend (Vite + React)
# Uso opcional: docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
