# =============================================================================
# TuRutaMed - Variables de entorno (plantilla SIN credenciales reales)
# Copiar a .env y reemplazar todos los valores "change_me_*".
# =============================================================================

# Aplicación
APP_NAME=TuRutaMed API
APP_VERSION=2.5.0
ENVIRONMENT=dev
DEBUG=false

# MySQL
# En Docker, docker-compose inyecta MYSQL_URL usando el host "mysql".
# En local, esta URL debe apuntar a localhost.
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=turutamed
MYSQL_USER=turutamed
MYSQL_PASSWORD=change_me_db_password
MYSQL_URL=mysql+pymysql://turutamed:change_me_db_password@localhost:3306/turutamed
MYSQL_HOST_PORT=3306

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=turutamed_db
MONGO_HOST_PORT=27017

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379

# Seguridad / JWT
# Debe tener al menos 32 caracteres.
SECRET_KEY=change_me_jwt_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Google Gemini
GEMINI_API_KEY=change_me_google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# CORS (el frontend de Docker usa el proxy /api/v1 del mismo origen)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend
# Docker + Nginx: /api/v1 (Nginx proxya a http://backend:8000).
# Frontend local con npm run dev: usar TuRutaMed_Frontend/.env.
VITE_API_URL=/api/v1
VITE_API_URL_LOCAL=http://localhost:8000
PORT=8000
