# Configuración de Entorno - TuRutaMed Backend

# Aplicación
APP_NAME=TuRutaMed API
APP_VERSION=2.5.0
ENVIRONMENT=dev
DEBUG=false

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=turutamed
MYSQL_USER=turutamed
MYSQL_PASSWORD=turutamedpass
MYSQL_URL=mysql+pymysql://turutamed:turutamedpass@localhost:3306/turutamed

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=turutamed_db

# Redis
REDIS_URL=redis://localhost:6379

# Seguridad / JWT
SECRET_KEY=tu_clave_secreta_jwt_muy_segura_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# IA (Gemini)
GEMINI_API_KEY=tu_api_key_de_google_genai_aqui
GEMINI_MODEL=gemini-1.5-flash

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
PORT=8000
