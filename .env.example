# Configuración de Entorno - TuRutaMed Backend

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=turutamed
MYSQL_USER=turutamed
MYSQL_PASSWORD=turutamedpass
MYSQL_URL=mysql+pymysql://turutamed:turutamedpass@localhost:3306/turutamed

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=turutamed_db

# Redis
REDIS_URL=redis://localhost:6379

# Seguridad
SECRET_KEY=tu_clave_secreta_jwt_muy_segura

# IA (Gemini)
GEMINI_API_KEY=tu_api_key_de_google_genai_aqui

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
PORT=8000
